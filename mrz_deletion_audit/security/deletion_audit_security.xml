<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mrz_deletion_audit" model="ir.module.category">
        <field name="name">Deletion Audit</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_mrz_deletion_audit_user" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_mrz_deletion_audit"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Reads the deletion logs of the models the user is allowed to read.</field>
    </record>

    <record id="group_mrz_deletion_audit_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_mrz_deletion_audit"/>
        <field name="implied_ids" eval="[Command.link(ref('group_mrz_deletion_audit_user'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Reads all deletion logs and configures the tracking rules.</field>
    </record>

    <record id="rule_mrz_deletion_audit_log_company" model="ir.rule">
        <field name="name">Deletion log: multi-company</field>
        <field name="model_id" ref="model_mrz_deletion_audit_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Deleted records cannot be checked against record rules any more, so
         auditors see the logs of the models they have read access to. -->
    <record id="rule_mrz_deletion_audit_log_auditor" model="ir.rule">
        <field name="name">Deletion log: auditors see readable models</field>
        <field name="model_id" ref="model_mrz_deletion_audit_log"/>
        <field name="domain_force">[('readable_by_user', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_mrz_deletion_audit_user'))]"/>
    </record>

    <record id="rule_mrz_deletion_audit_log_manager" model="ir.rule">
        <field name="name">Deletion log: administrators see all models</field>
        <field name="model_id" ref="model_mrz_deletion_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_mrz_deletion_audit_manager'))]"/>
    </record>
</odoo>
